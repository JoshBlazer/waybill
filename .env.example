# Waybill environment. Copy to .env for local overrides; .env is git-ignored.
# The Compose stack (deploy/compose.yaml) already sets local defaults, so
# nothing here is required for `make up`.
#
# TEST MONEY ONLY. The services refuse to start if any chain below is not an
# allowed test network or if a provider key is not a test-mode key.

# PostgreSQL connection string.
DATABASE_URL=postgres://waybill:waybill-local-only@localhost:55432/waybill?sslmode=disable

# API listen address.
HTTP_ADDR=:8080

# Comma-separated <network>=<rpc url>[|<fallback url>...]. Allowed networks:
#   evm:31337 (Anvil), evm:84532 (Base Sepolia), evm:11155111 (Ethereum Sepolia),
#   btc:regtest, btc:signet
# The first URL is the primary; calls fail over to the others when it fails
# (ADR-045). Every RPC, fallbacks included, must report the configured chain
# id at startup.
WAYBILL_CHAINS=evm:31337=http://localhost:58545

# Metrics and traces (ADR-045). Empty means off. Any OTLP/HTTP collector
# works; the standard OTEL_* variables apply. make up-observability sets it
# to the bundled grafana/otel-lgtm container.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Paystack secret key. Must begin with sk_test_. Leave empty until stage 3.
PAYSTACK_SECRET_KEY=

# Reported by /v1/health.
WAYBILL_VERSION=0.1.0-dev

# Web: where the Next.js server reaches the API.
API_INTERNAL_URL=http://localhost:8080

# The key the worker signs sweeps and payouts with: hex in WAYBILL_SIGNER_KEY,
# or a file (mode 600, outside the repo) in WAYBILL_SIGNER_KEY_FILE. Unset
# means the worker sends nothing. `make up` generates one for the local stack
# in deploy/.env. Test networks only; never print it.
WAYBILL_SIGNER_KEY=
WAYBILL_SIGNER_KEY_FILE=
